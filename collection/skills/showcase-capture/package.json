{
  "name": "showcase-capture",
  "version": "0.1.0",
  "description": "Capture screenshots, GIFs and WebM tours of web apps from a YAML or TypeScript config.",
  "author": "Benjamin McCusker",
  "keywords": [
    "playwright",
    "screenshots",
    "gif",
    "webm",
    "showcase",
    "agent-skill"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "showcase-capture": "./dist/cli.js"
  },
  "files": [
    "dist",
    "references",
    "scripts",
    "templates",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test && node dist/cli.js check --config examples/static-site/showcase.config.yaml",
    "install:browser": "playwright install chromium"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "jiti": "^2.4.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
